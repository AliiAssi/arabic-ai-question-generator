{
  "response_schema": {
    "type": "object",
    "required": ["questions"],
    "propertyOrdering": ["questions"],
    "properties": {
      "questions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["question", "options", "correct_answer"],
          "propertyOrdering": ["question", "options", "correct_answer"],
          "properties": {
            "question": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "correct_answer": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          }
        }
      }
    }
  }
}